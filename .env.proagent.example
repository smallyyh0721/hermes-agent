# Copy to .env.proagent before running docker compose.

# LLM provider used by proagent.yaml.example defaults.
MINIMAX_CN_API_KEY=

# Alternative providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Discord 7x24 gateway.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional outbound proxy for Discord connectivity.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Healthcheck listener used by Docker.
PROAGENT_HEALTH_HOST=0.0.0.0
PROAGENT_HEALTH_PORT=8790
